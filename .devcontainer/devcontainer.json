{
    "name": "Fluid4.0 Microservice DBC Development Container",
    "dockerComposeFile": "./docker-compose.yaml",
    "shutdownAction": "stopCompose",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "forwardPorts": [
        1433
    ],
    "service": "dev_container",
    "customizations": {
        "vscode": {
            "settings": {
                "python.defaultInterpreterPath": "$/usr/local/bin/python",
                "python.poetryPath": "/home/vscode/.local/bin/poetry",
                "python.analysis.extraPaths": [
                    "${containerWorkspaceFolder}"
                ],
                "python.analysis.exclude": [
                    ".build",
                    ".cache",
                    ".mypy_cache",
                    ".pytest_cache",
                    "dist",
                    "docs"
                ],
                "terminal.integrated.profiles.linux": {
                    "zsh": {
                        "path": "/bin/zsh"
                    },
                    "bash": null
                },
                "terminal.integrated.defaultProfile.linux": "zsh",
                "http.proxyStrictSSL": false
            },
            "extensions": [
                // vscode nice to have
                "eamodio.gitlens",                          // better git views in vscode
                "mhutchie.git-graph",                       // a nice git graph
                "vivaxy.vscode-conventional-commits",       // conventional commits support
                "ryanluker.vscode-coverage-gutters",        // coverage visualization next to the code
                "aaron-bond.better-comments",               // comment highlighting
                "gruntfuggly.todo-tree",                    // to-do highlighting
                "medo64.render-crlf",                       // render CRLF line endings
                "esbenp.prettier-vscode",                   // automatic code formatting/prettifying
                // python related
                "ms-python.python",                         // python support
                "charliermarsh.ruff",                       // ruff linter (flake8 replacement)
                "ms-python.mypy-type-checker",              // mypy type checker
                "njpwerner.autodocstring",                  // auto docstrings
                "tamasfe.even-better-toml",                 // better TOML support (for pyproject.toml)
                "streetsidesoftware.code-spell-checker",    // Spelling Checker for Visual Studio Code
                "ms-python.debugpy",                        // Debugger for Python
                // documentation related
                "DavidAnson.vscode-markdownlint",           // markdown linting
                "bierner.github-markdown-preview",          // markdown preview pack that mimics github
                "perkovec.emoji",                           // unicode emoji selector for vscode (F1-> type 'emoji')
                "yzhang.markdown-all-in-one",               // All you need to write Markdown
                // ai related
                "GitHub.copilot",
                "GitHub.copilot-chat"
            ]
        }
    },
    // As a post create command we install the poetry dependencies and also install the pre-commit hooks.
    // It's necessary to do this here because in Dockerfile we do not have the config files (pyproject.toml +
    // .pre-commit-config.yaml) available.
    "onCreateCommand": "chmod +x .devcontainer/on_create_command.sh && .devcontainer/on_create_command.sh",
    "remoteUser": "vscode"
    //"postCreateCommand": "pip install --no-cache-dir -r requirements.txt"
}
